{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/capability-certification-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "status", "capability", "profile", "provider_identity", "issuer", "tested_commit", "implementation_fingerprint", "issued_at", "expires_at", "environment", "authorization", "checks", "provider_evidence", "no_secrets", "digest"],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "receipt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "status": {"enum": ["CANDIDATE", "PASS"]},
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"const": "commands"}, "id": {"type": "string", "minLength": 1}}
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}}
    },
    "provider_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "account_subject_sha256", "target_subject_sha256"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "account_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "issuer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity", "attestation"],
      "properties": {
        "kind": {"enum": ["local_candidate", "external_attestation"]},
        "identity": {"type": "string", "minLength": 1},
        "attestation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]}
      }
    },
    "tested_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "environment": {"enum": ["sandbox", "test", "production-read-only", "controlled-public-target"]},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["live_requested", "confirmation", "authorized_target_sha256", "cost_approved", "write_approved"],
      "properties": {
        "live_requested": {"const": true},
        "confirmation": {"const": "LIVE_CERTIFY"},
        "authorized_target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cost_approved": {"type": "boolean"},
        "write_approved": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["prerequisites", "auth_preflight", "fixture_replay", "adverse_cases", "live_probe", "redaction"],
      "properties": {
        "prerequisites": {"$ref": "#/$defs/check"},
        "auth_preflight": {"$ref": "#/$defs/check"},
        "fixture_replay": {"$ref": "#/$defs/check"},
        "adverse_cases": {"$ref": "#/$defs/check"},
        "live_probe": {"$ref": "#/$defs/check"},
        "redaction": {"$ref": "#/$defs/check"}
      }
    },
    "provider_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id_sha256", "provider_log", "application_log"],
      "properties": {
        "request_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_log": {"$ref": "#/$defs/evidence"},
        "application_log": {"$ref": "#/$defs/evidence"}
      }
    },
    "no_secrets": {"const": true},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "path", "sha256", "tested_commit"],
      "properties": {
        "type": {"enum": ["source", "automated_test", "fixture_replay", "adverse_test", "auth_result", "live_observation", "redaction_report", "provider_log", "application_log", "external_attestation"]},
        "path": {"type": "string", "pattern": "^evaluation/provider-evidence/[a-z0-9][a-z0-9.-]+/[A-Za-z0-9_.-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tested_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"const": "PASS"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
