{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wfprieto/World-Class-SEO-Agent-System/schemas/autonomous-seo-reviewer-provenance.schema.json",
  "title": "WCSEO Autonomous SEO Reviewer Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "reviewer_id",
    "role",
    "context_id",
    "provider",
    "model",
    "candidate_commit",
    "evidence_package_hash",
    "execution_id",
    "verification_method",
    "verification_state",
    "issuer",
    "builder_controlled",
    "submitted_at"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/autonomous-seo-reviewer-provenance.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "minLength": 8},
    "reviewer_id": {"enum": ["senior-scrummaster-3", "vp-engineering"]},
    "role": {"enum": ["SENIOR_SCRUMMASTER_3", "VP_ENGINEERING"]},
    "context_id": {"type": "string", "minLength": 8},
    "provider": {"type": "string", "minLength": 2},
    "model": {"type": "string", "minLength": 2},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "minLength": 8},
    "verification_method": {
      "enum": ["PROVIDER_SIGNED_ATTESTATION", "CI_AUTHENTICATED_EXTERNAL_EXECUTION"]
    },
    "verification_state": {"const": "VERIFIED"},
    "issuer": {"type": "string", "minLength": 3},
    "builder_controlled": {"const": false},
    "submitted_at": {"type": "string", "format": "date-time"}
  }
}
