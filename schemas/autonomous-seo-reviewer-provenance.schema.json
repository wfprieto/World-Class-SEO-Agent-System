{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wfprieto/World-Class-SEO-Agent-System/schemas/autonomous-seo-reviewer-provenance.schema.json",
  "title": "WCSEO Autonomous SEO Reviewer Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "reviewer_id",
    "role",
    "context_id",
    "provider",
    "model",
    "repository_full_name",
    "pull_request_number",
    "base_commit",
    "candidate_commit",
    "canonical_ci_run_id",
    "evidence_package_hash",
    "trigger_comment_id",
    "result_kind",
    "result_id",
    "result_actor_login",
    "execution_id",
    "verification_method",
    "verification_state",
    "issuer",
    "builder_controlled",
    "submitted_at"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/autonomous-seo-reviewer-provenance.schema.json"},
    "schema_version": {"const": "1.1.0"},
    "receipt_id": {"type": "string", "minLength": 8},
    "reviewer_id": {"enum": ["senior-scrummaster-3", "vp-engineering"]},
    "role": {"enum": ["SENIOR_SCRUMMASTER_3", "VP_ENGINEERING"]},
    "context_id": {"type": "string", "minLength": 8},
    "provider": {"enum": ["GITHUB_CLAUDE_AGENT", "GITHUB_CODEX_AGENT"]},
    "model": {"type": "string", "minLength": 2},
    "repository_full_name": {"const": "wfprieto/World-Class-SEO-Agent-System"},
    "pull_request_number": {"const": 37},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "canonical_ci_run_id": {"type": "integer", "minimum": 1},
    "evidence_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trigger_comment_id": {"type": "integer", "minimum": 1},
    "result_kind": {"enum": ["ISSUE_COMMENT", "PULL_REQUEST_REVIEW", "TRIGGER_REACTION"]},
    "result_id": {"type": "integer", "minimum": 1},
    "result_actor_login": {"enum": ["claude[bot]", "chatgpt-codex-connector[bot]"]},
    "execution_id": {"type": "string", "pattern": "^github:(issue-comment|pull-request-review|trigger-reaction):[0-9]+$"},
    "verification_method": {"const": "CI_AUTHENTICATED_GITHUB_AGENT"},
    "verification_state": {"const": "REQUIRES_LIVE_VERIFICATION"},
    "issuer": {"const": "github-actions-provider-authentication"},
    "builder_controlled": {"const": false},
    "submitted_at": {"type": "string", "format": "date-time"}
  }
}
