{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-class-seo.local/schemas/seoctl-command-output.json",
  "title": "seoctl command result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "status", "data", "warnings", "error"],
  "properties": {
    "command": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "ok", "complete", "success", "needs-review", "partial", "empty",
        "not_found", "not_configured", "invalid", "invalid_response", "blocked",
        "failed", "unauthorized", "rate_limited", "input_error", "unavailable"
      ]
    },
    "data": {},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["type", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "state": {"enum": ["INPUT_ERROR", "UNAVAILABLE", "BLOCKED", "FAILED"]},
            "message": {"type": "string"}
          }
        }
      ]
    }
  }
}
