{
  "schema_version": "1.0.0",
  "layers": {
    "runtime": "runtime",
    "adapters": "adapters",
    "integrations": "integrations",
    "composition": "seoctl",
    "contracts": "contracts",
    "security": "security"
  },
  "allowed_layer_edges": [
    {
      "source": "composition",
      "target": "runtime"
    },
    {
      "source": "composition",
      "target": "adapters"
    },
    {
      "source": "composition",
      "target": "integrations"
    },
    {
      "source": "runtime",
      "target": "contracts"
    },
    {
      "source": "adapters",
      "target": "contracts"
    },
    {
      "source": "integrations",
      "target": "contracts"
    },
    {
      "source": "adapters",
      "target": "security"
    },
    {
      "source": "integrations",
      "target": "security"
    }
  ],
  "exceptions": [],
  "network_modules": [
    "adapters/llm_transport.py",
    "adapters/rendered_page.py",
    "integrations/authority_media/transport.py",
    "integrations/extensions/indexnow.py",
    "integrations/google/client.py",
    "integrations/google/oauth.py",
    "integrations/google/transport.py",
    "integrations/technical/browser.py",
    "integrations/technical/http.py",
    "runtime/llm.py",
    "security/browser_capture.py",
    "security/browser_proxy.py",
    "security/pinned_http.py",
    "security/url_safety.py"
  ],
  "network_transports": {
    "adapters/llm_transport.py": {
      "policy": "CONFIGURED_LLM_PINNED_TRANSPORT",
      "delegates_to": "security.pinned_http.PinnedHTTPHandler + security.pinned_http.PinnedHTTPSHandler"
    },
    "adapters/rendered_page.py": {
      "policy": "PUBLIC_RENDERED_PAGE",
      "delegates_to": "integrations.technical.http.BoundedHttpClient + security.url_safety.validate_public_url"
    },
    "security/url_safety.py": {
      "policy": "PUBLIC_URL_SAFETY",
      "delegates_to": "security.url_safety.validate_public_url"
    },
    "security/pinned_http.py": {
      "policy": "VETTED_NUMERIC_HTTP_TLS",
      "delegates_to": "security.url_safety.resolve_public_addresses"
    },
    "security/browser_proxy.py": {
      "policy": "BOUNDED_NUMERIC_BROWSER_EGRESS",
      "delegates_to": "security.pinned_http.public_connection"
    },
    "security/browser_capture.py": {
      "policy": "ISOLATED_BROWSER_CONTEXT",
      "delegates_to": "security.browser_proxy.BrowserEgress"
    },
    "integrations/authority_media/transport.py": {
      "policy": "APPROVED_HOST_BOUNDED_HTTP",
      "delegates_to": "integrations.authority_media.transport.BoundedTransport"
    },
    "integrations/extensions/indexnow.py": {
      "policy": "NO_REDIRECT_PUBLIC_MUTATION",
      "delegates_to": "integrations.extensions.indexnow.NoRedirect"
    },
    "integrations/google/client.py": {
      "policy": "GOOGLE_API_BOUNDED_HTTP",
      "delegates_to": "integrations.google.client"
    },
    "integrations/technical/browser.py": {
      "policy": "PUBLIC_BROWSER_REQUEST_GUARD",
      "delegates_to": "integrations.technical.browser"
    },
    "integrations/technical/http.py": {
      "policy": "PUBLIC_WEB_EVERY_HOP",
      "delegates_to": "integrations.technical.http.BoundedHttpClient"
    },
    "runtime/llm.py": {
      "policy": "CONFIGURED_LLM_ENDPOINT_BOUNDED_HTTP",
      "delegates_to": "runtime.llm"
    },
    "integrations/google/oauth.py": {
      "policy": "GOOGLE_API_BOUNDED_HTTP",
      "delegates_to": "integrations.google.oauth.GoogleOAuthProvider"
    },
    "integrations/google/transport.py": {
      "policy": "GOOGLE_API_BOUNDED_HTTP",
      "delegates_to": "integrations.google.transport._NoCrossHostRedirects"
    }
  }
}
